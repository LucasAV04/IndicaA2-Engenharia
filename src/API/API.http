@API_HostAddress = http://localhost:5209

POST {{API_HostAddress}}/api/indicacoes
Content-Type: application/json

{
  "usuarioIndicadorId": "11111111-1111-1111-1111-111111111111",
  "nomeIndicada": "Ana Indicada",
  "telefoneIndicada": "11999999999",
  "codigoIndicacaoUsado": "A2-123"
}

###

GET {{API_HostAddress}}/api/indicacoes
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/por-indicador/11111111-1111-1111-1111-111111111111
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/por-status/Pendente
Accept: application/json

###

PATCH {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111/usuario-indicado
