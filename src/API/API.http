@API_HostAddress = http://localhost:5209
@AccessToken = INSIRA_TOKEN_AQUI

POST {{API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "usuario@exemplo.com",
  "senha": "SenhaExemplo"
}

###

POST {{API_HostAddress}}/api/indicacoes
Content-Type: application/json

{
  "usuarioIndicadorId": "11111111-1111-1111-1111-111111111111",
  "nomeIndicada": "Ana Indicada",
  "telefoneIndicada": "11999999999",
  "codigoIndicacaoUsado": "A2-123"
}

###

GET {{API_HostAddress}}/api/indicacoes
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/por-indicador/11111111-1111-1111-1111-111111111111
Accept: application/json

###

GET {{API_HostAddress}}/api/indicacoes/por-status/Pendente
Accept: application/json

###

PATCH {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111/usuario-indicado
Content-Type: application/json

{
  "indicacaoId": "11111111-1111-1111-1111-111111111111",
  "usuarioIndicadoId": "22222222-2222-2222-2222-222222222222"
}

###

PATCH {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111/vistoria
Content-Type: application/json

{
  "indicacaoId": "11111111-1111-1111-1111-111111111111",
  "vistoriaId": "33333333-3333-3333-3333-333333333333"
}

###

PATCH {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111/vistoria/concluir

###

PATCH {{API_HostAddress}}/api/indicacoes/11111111-1111-1111-1111-111111111111/cancelar

###

POST {{API_HostAddress}}/api/vistorias
Content-Type: application/json

{
  "usuarioId": "22222222-2222-2222-2222-222222222222",
  "tipoPlanta": "Apartamento",
  "areaM2": 75.5,
  "pacote": 0,
  "dataAgendada": "2026-09-15T14:30:00"
}

###

GET {{API_HostAddress}}/api/vistorias
Accept: application/json

###

GET {{API_HostAddress}}/api/vistorias/33333333-3333-3333-3333-333333333333
Accept: application/json

###

GET {{API_HostAddress}}/api/vistorias/por-usuario/22222222-2222-2222-2222-222222222222
Accept: application/json

###

PATCH {{API_HostAddress}}/api/vistorias/33333333-3333-3333-3333-333333333333/realizar

###

PATCH {{API_HostAddress}}/api/vistorias/33333333-3333-3333-3333-333333333333/concluir

###

