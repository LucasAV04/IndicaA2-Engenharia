@API_HostAddress = http://localhost:5209
@AccessToken = INSIRA_TOKEN_AQUI

POST {{API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "usuario@exemplo.com",
  "senha": "SenhaExemplo"
}

