# Inventário de configuração; .NET não carrega este arquivo automaticamente.
# Forneça valores privados no ambiente do processo. Não versione .env real.
RecebimentoPix__Habilitado=false
RecebimentoPix__ProcessamentoWorker__Habilitado=false
RecebimentoPix__ProcessamentoWorker__IntervaloSegundos=30
RecebimentoPix__ProcessamentoWorker__TamanhoLote=20
RecebimentoPix__ExpiracaoSegundos=3600
RecebimentoPix__UrlPublica=https://example.invalid
RecebimentoPix__WebhookUrl=https://example.invalid/api/webhooks/efi
RecebimentoPix__ChaveRecebedora=
RecebimentoPix__WebhookCaPath=
INDICA2_COBRANCA_PIX_ENCRYPTION_KEY=
EfiPix__Environment=Sandbox
EfiPix__BaseUrl=https://pix-h.api.efipay.com.br
EfiPix__ClientId=
EfiPix__ClientSecret=
EfiPix__CertificatePath=
EfiPix__CertificatePassword=
PublicWeb__BaseUrl=https://example.invalid
CashbackPagamentoPreparacaoWorker__Habilitado=false
CashbackPagamentoPreparacaoWorker__IntervaloSegundos=60
CashbackPagamentoPreparacaoWorker__TamanhoLote=20
# Chave externa AES-256; não preencha nem versione material real neste arquivo.
INDICA2_DADOS_PIX_ENCRYPTION_KEY=

# O Compose de homologação usa arquivos privados gerados por Invoke-Homologation.ps1.
# Consulte docs/HomologacaoOperacional.md. Não copie segredos para este arquivo.

# E-mail transacional. Segredos externos, sem SMTP no ambiente padrão.
Email__Habilitado=false
Email__Host=
Email__Port=
Email__Usuario=
Email__Senha=
Email__Remetente=
Email__UsarTls=true
Email__TokenKey=
Email__Worker__Habilitado=false
Email__Worker__IntervaloSegundos=30
Email__Worker__TamanhoLote=20
